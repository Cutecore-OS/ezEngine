// ============================================================================
// ToonLatexMaterial.ezShader — Anime/Toon + Latex Material Shader for ezEngine
//
// Strategy: ALL shading math lives inside GetEmissiveColor().  The standard
// PBR BRDF is suppressed (GetBaseColor=0, GetRoughness=1, GetMetallic=0)
// so the engine's lighting pipeline effectively contributes nothing — every
// pixel colour comes from our toon/latex calculations routed through emissive.
//
// Features:
//   ● Toon diffuse with configurable shadow color, threshold, feather
//   ● Half-Lambert wrap lighting for softer shadow transitions
//   ● Blinn-Phong anime specular with threshold + softness controls
//   ● Fresnel rim lighting with power control
//   ● Outline via NdotV edge detection (inverted hull look in screen space)
//   ● Emission multiplier for HDR bloom glow
//   ● Auto-detection of brightest directional light (or manual LightDirection)
//   ● Latex/glossy Fresnel clearcoat mode (UseLatexFresnel)
//   ● Full engine integration: shadows, decals, fog, SSAO, all editor passes
//   ● Alpha-test, transparent, additive blend modes
//   ● Normal mapping, skinning, parallax-ready
// ============================================================================

[PLATFORMS]
ALL

[PERMUTATIONS]

BLEND_MODE
RENDER_PASS
SHADING_MODE
TWO_SIDED
FLIP_WINDING
FORWARD_PASS_WRITE_DEPTH
MSAA
CAMERA_MODE
SHADING_QUALITY
VERTEX_SKINNING

[MATERIALPARAMETER]

Permutation BLEND_MODE;
Permutation SHADING_MODE;
Permutation TWO_SIDED;

// =====================================================================
//  BASE
// =====================================================================
// @brief Base color tint. Alpha controls opacity in masked mode.
// @default White
Color BaseColor @Default(Color(1.0, 1.0, 1.0));

// @brief Sample albedo from texture (RGB multiply, A for opacity)
bool UseBaseTexture;
Texture2D BaseTexture;

// @brief Alpha test threshold (masked blend mode)
float MaskThreshold @Default(0.25) @Clamp(0.0, 1.0);
Texture2D DitherNoiseTexture @Default("{ ac614d7c-2b31-4a7b-aa0c-c5d8200b7b89 }");

// =====================================================================
//  NORMAL MAP
// =====================================================================
bool UseNormalTexture;
Texture2D NormalTexture;

// =====================================================================
//  TOON DIFFUSE
// =====================================================================
// @category Toon Diffuse
// @brief Shadow tint color. Multiplied with albedo in shadowed regions.
// @default Soft blue-grey
Color ShadowColor @Default(Color(0.6, 0.6, 0.7));

// @category Toon Diffuse
// @brief Half-Lambert value where shadow transitions to lit.
//        0.5 = standard terminator, 0.3 = more shadow, 0.7 = more light.
// @default 0.5
float ShadowThreshold @Default(0.5) @Clamp(0.0, 1.0);

// @category Toon Diffuse
// @brief Shadow edge softness. 0 = perfectly hard anime edge, 0.1 = soft blend.
// @default 0.02
float ShadowFeather @Default(0.02) @Clamp(0.0, 1.0);

// =====================================================================
//  RIM LIGHTING
// =====================================================================
// @category Rim
// @brief Rim light color. White for general glow, blue/pink for anime.
// @default White
Color RimColor @Default(Color(1.0, 1.0, 1.0));

// @category Rim
// @brief Fresnel exponent. Lower = wider rim, higher = thinner edge.
// @default 4.0
float RimPower @Default(4.0) @Clamp(0.1, 10.0);

// @category Rim
// @brief Rim intensity multiplier. 0 = off.
// @default 1.0
float RimIntensity @Default(1.0) @Clamp(0.0, 5.0);

// =====================================================================
//  ANIME SPECULAR
// =====================================================================
// @category Specular
// @brief Specular highlight tint.
// @default White
Color SpecColor @Default(Color(1.0, 1.0, 1.0));

// @category Specular
// @brief Blinn-Phong exponent. Higher = tighter highlight.
//        16 = broad, 64 = anime spot, 256 = ultra-sharp star.
// @default 64.0
float SpecPower @Default(64.0) @Clamp(4.0, 512.0);

// @category Specular
// @brief Brightness threshold. Higher = smaller visible spot.
//        1.0 = effectively OFF.
// @default 0.8
float SpecularThreshold @Default(0.8) @Clamp(0.0, 1.0);

// @category Specular
// @brief Edge softness of the specular spot.
// @default 0.1
float SpecularSoftness @Default(0.1) @Clamp(0.0, 1.0);

// @category Specular
// @brief Specular intensity multiplier.
// @default 1.0
float SpecularIntensity @Default(1.0) @Clamp(0.0, 5.0);

// =====================================================================
//  OUTLINE
// =====================================================================
// @category Outline
// @brief Outline color. Black for classic anime outlines.
// @default Black
Color OutlineColor @Default(Color(0.0, 0.0, 0.0));

// @category Outline
// @brief Outline width (NdotV threshold). 0 = no outline, 1 = everything is outline.
// @default 0.3
float OutlineWidth @Default(0.3) @Clamp(0.0, 1.0);

// =====================================================================
//  SHADOW RECEIVING
// =====================================================================
// @category Shadows
// @brief Enable receiving shadows from other objects.
//        Uses the engine's pre-computed shadow masks for the brightest
//        directional light. Shadowed regions get darkened by ShadowColor.
bool UseShadowReceiving;

// =====================================================================
//  BACKLIGHT (Contre-jour / Rim from behind)
// =====================================================================
// @category Backlight
// @brief Enable backlight detection. When the sun is behind the object
//        (silhouette from camera POV), outline and rim light up —
//        simulating anime contre-jour / subsurface glow.
bool UseBacklight;

// --- Backlight RIM ---
// @category Backlight Rim
// @brief Backlight rim color. Warm orange/gold for sunset contre-jour.
// @default Warm orange-gold
Color BacklightRimColor @Default(Color(1.0, 0.7, 0.3));

// @category Backlight Rim
// @brief When true: BacklightRimColor is MIXED with original RimColor.
//        When false: BacklightRimColor REPLACES RimColor when backlit.
// @default true
bool BacklightRimMixBase @Default(true);

// @category Backlight Rim
// @brief Backlight rim intensity multiplier.
// @default 1.5
float BacklightRimIntensity @Default(1.5) @Clamp(0.0, 5.0);

// @category Backlight Rim
// @brief Fresnel exponent for the backlight rim. Lower = wider glow.
// @default 2.5
float BacklightRimPower @Default(2.5) @Clamp(0.5, 8.0);

// --- Backlight OUTLINE ---
// @category Backlight Outline
// @brief Backlight outline color. Warm orange for anime contre-jour.
// @default Warm orange-gold
Color BacklightOutlineColor @Default(Color(1.0, 0.7, 0.3));

// @category Backlight Outline
// @brief When true: BacklightOutlineColor is MIXED with original OutlineColor.
//        When false: BacklightOutlineColor REPLACES OutlineColor when backlit.
// @default false
bool BacklightOutlineMixBase @Default(false);

// @category Backlight Outline
// @brief Backlight outline intensity multiplier.
// @default 1.0
float BacklightOutlineIntensity @Default(1.0) @Clamp(0.0, 5.0);

// @category Backlight Outline
// @brief How much the outline widens when backlit. 0 = no widening.
// @default 0.15
float BacklightOutlineExpand @Default(0.15) @Clamp(0.0, 0.5);

// --- Backlight Common ---
// @category Backlight
// @brief Minimum backlight factor threshold. Only activates above this.
// @default 0.1
float BacklightThreshold @Default(0.1) @Clamp(0.0, 1.0);


// =====================================================================
//  LIGHT SOURCE
// =====================================================================
// @category Light
// @brief When true, uses the engine's brightest directional light (sun).
//        When false, uses the manual LightDirection vector below.
// @default true
bool UseEngineLightDirection @Default(true);

// @category Light


// @category Light
// @brief Manual light direction (world space, toward the light source).
//        Only used when UseEngineLightDirection == false.
// @default (0.5, 1.0, 0.5)
float3 LightDirection @Default(float3(0.5, 1.0, 0.5));

// =====================================================================
//  EMISSION
// =====================================================================
// @category Emission
// @brief HDR emission multiplier. Values >1 push the final color above 1.0
//        which triggers the engine's bloom pass → real glowing effect.
//        1.0 = normal brightness, 3.0 = subtle glow, 5.0+ = strong glow.
// @default 1.0
float EmissionMultiplier @Default(1.0) @Clamp(0.0, 20.0);

// =====================================================================
//  LATEX / GLOSSY FRESNEL (optional overlay)
// =====================================================================
// @category Latex
// @brief Enable latex/glossy Fresnel overlay. Adds Fresnel-enhanced
//        specular sheen on top of the toon shading for wet/latex look.
bool UseLatexFresnel;

// @category Latex
// @brief Fresnel exponent for the glossy sheen. Lower = wider sheen.
// @default 5.0
float LatexFresnelPower @Default(5.0) @Clamp(1.0, 12.0);

// @category Latex
// @brief Glossy Fresnel tint color.
// @default Slightly warm white
Color LatexFresnelColor @Default(Color(1.0, 0.98, 0.95));

// @category Latex
// @brief Glossy Fresnel intensity.
// @default 0.3
float LatexFresnelIntensity @Default(0.3) @Clamp(0.0, 2.0);


[MATERIALCONFIG]

#include <Shaders/Materials/MaterialConfig.h>

[RENDERSTATE]

#include <Shaders/Materials/MaterialState.h>

[MATERIALCONSTANTS]

COLOR4F(BaseColor);
COLOR4F(ShadowColor);
COLOR4F(RimColor);
COLOR4F(SpecColor);
COLOR4F(OutlineColor);
COLOR4F(LatexFresnelColor);
COLOR4F(BacklightRimColor);
COLOR4F(BacklightOutlineColor);

FLOAT1(MaskThreshold);
FLOAT1(ShadowThreshold);
FLOAT1(ShadowFeather);
FLOAT1(RimPower);
FLOAT1(RimIntensity);
FLOAT1(SpecPower);
FLOAT1(SpecularThreshold);
FLOAT1(SpecularSoftness);
FLOAT1(SpecularIntensity);
FLOAT1(OutlineWidth);
FLOAT1(EmissionMultiplier);
FLOAT1(LatexFresnelPower);
FLOAT1(LatexFresnelIntensity);
FLOAT1(BacklightRimIntensity);
FLOAT1(BacklightOutlineIntensity);
FLOAT1(BacklightOutlineExpand);
FLOAT1(BacklightRimPower);
FLOAT1(BacklightThreshold);

FLOAT3(LightDirection);

BOOL1(UseBaseTexture);
BOOL1(UseNormalTexture);
BOOL1(UseEngineLightDirection);

BOOL1(UseLatexFresnel);
BOOL1(UseShadowReceiving);
BOOL1(UseBacklight);
BOOL1(BacklightRimMixBase);
BOOL1(BacklightOutlineMixBase);


// =====================================================================
//  VERTEX SHADER
// =====================================================================
[SHADER]

#define USE_NORMAL
#define USE_TANGENT
#define USE_TEXCOORD0
#define USE_TWO_SIDED_LIGHTING

#if RENDER_PASS == RENDER_PASS_EDITOR
  #define USE_DEBUG_INTERPOLATOR
#endif

[VERTEXSHADER]

#if VERTEX_SKINNING
  #define USE_SKINNING
#endif

#include <Shaders/Materials/MaterialVertexShader.h>

VS_OUT main(VS_IN Input)
{
  return FillVertexData(Input);
}


// =====================================================================
//  PIXEL SHADER
//
//  We include MaterialPixelShader.h which defines main().
//  All our custom toon logic lives in GetEmissiveColor() which the
//  engine calls from FillMaterialData().  We suppress the standard
//  BRDF by returning black diffuse, zero metallic, max roughness.
// =====================================================================
[PIXELSHADER]

#define USE_SIMPLE_MATERIAL_MODEL
#define USE_MATERIAL_EMISSIVE
#define USE_MATERIAL_OCCLUSION
#define USE_DECALS
#define USE_FOG
#define USE_CUSTOM_DITHER_NOISE

#include <Shaders/Materials/MaterialPixelShader.h>

Texture2D BaseTexture BIND_GROUP(BG_MATERIAL);
SamplerState BaseTexture_AutoSampler BIND_GROUP(BG_MATERIAL);

Texture2D NormalTexture BIND_GROUP(BG_MATERIAL);
SamplerState NormalTexture_AutoSampler BIND_GROUP(BG_MATERIAL);

Texture2D DitherNoiseTexture BIND_GROUP(BG_MATERIAL);

// =====================================================================
//  MATERIAL FUNCTIONS — Standard pipeline hooks
// =====================================================================

float3 GetNormal()
{
  [branch]
  if (GetMaterialData(UseNormalTexture))
  {
    float3 normalTS = DecodeNormalTexture(NormalTexture.Sample(NormalTexture_AutoSampler, G.Input.TexCoord0.xy));
    return TangentToWorldSpace(normalTS);
  }
  else
  {
    return G.Input.Normal;
  }
}

// Suppress standard PBR — all shading is in GetEmissiveColor()
float3 GetBaseColor()     { return float3(0, 0, 0); }
float  GetMetallic()      { return 0.0f; }
float  GetReflectance()   { return 0.0f; }
float  GetRoughness()     { return 1.0f; }
float  GetOcclusion()     { return 1.0f; }

float GetOpacity()
{
  #if BLEND_MODE == BLEND_MODE_MASKED
    float opacity = GetMaterialData(BaseColor).a * GetInstanceData().Color.a;
    [branch]
    if (GetMaterialData(UseBaseTexture))
    {
      opacity *= BaseTexture.Sample(BaseTexture_AutoSampler, G.Input.TexCoord0.xy).a;
    }
    return opacity - GetMaterialData(MaskThreshold);
  #else
    return 1.0f;
  #endif
}

float4 GetDitherNoise(float2 pixelCoord)
{
  uint2 noiseTextureSize;
  DitherNoiseTexture.GetDimensions(noiseTextureSize.x, noiseTextureSize.y);
  return DitherNoiseTexture.SampleLevel(PointSampler, pixelCoord / noiseTextureSize, 0);
}


// =====================================================================
//  TOON + LATEX EMISSIVE
//
//  This is called from FillMaterialData() inside the engine's main().
//  We have access to: world position, normals, tex coords, camera pos,
//  and the engine's brightest directional light via
//  GetBrightestDirectionalLightData().
// =====================================================================
float3 GetEmissiveColor()
{
  // ---- Sample albedo ----
  float3 albedo = GetMaterialData(BaseColor).rgb * GetInstanceData().Color.rgb;
  [branch]
  if (GetMaterialData(UseBaseTexture))
  {
    albedo *= BaseTexture.Sample(BaseTexture_AutoSampler, G.Input.TexCoord0.xy).rgb;
  }

  float3 normal  = normalize(GetNormal());
  float3 viewDir = normalize(GetCameraPosition() - G.Input.WorldPosition);

  // ---- Get light direction ----
  // GetLightDirection() returns the light's forward = FROM-light direction.
  // This matches the engine's PBR pipeline exactly (EvaluatePBRLight uses
  // GetLightDirection as lightDiffuseVector for NdotL).
  // DO NOT NEGATE.
  float3 lightDir;
  if (GetMaterialData(UseEngineLightDirection))
  {
    ezPerLightData sunData = GetBrightestDirectionalLightData();
    if (sunData.intensity > 0.0)
    {
      lightDir = GetLightDirection(sunData);
    }
    else
    {
      lightDir = normalize(GetMaterialData(LightDirection));
    }
  }
  else
  {
    lightDir = normalize(GetMaterialData(LightDirection));
  }

  // ================================================================
  //  TOON DIFFUSE — Half-Lambert with stepped shadow
  // ================================================================
  float NdotL       = dot(normal, lightDir);
  // ---- Handle two-sided lighting ----
  #if defined(USE_TWO_SIDED_LIGHTING)
    NdotL = G.Input.FrontFace ? NdotL : -NdotL;
  #endif

  float halfLambert = NdotL * 0.5 + 0.5; // Wrap to [0, 1]

  float shadowThreshold = GetMaterialData(ShadowThreshold);
  float shadowFeather   = GetMaterialData(ShadowFeather);

  // smoothstep creates the toon band: hard edge when feather ≈ 0
  float shadowWeight = smoothstep(
    shadowThreshold - shadowFeather,
    shadowThreshold + shadowFeather,
    halfLambert);

  // ================================================================
  //  SHADOW RECEIVING — real shadow maps from the engine
  // ================================================================
  // Samples the engine's cascaded shadow map so walls and other objects
  // properly cast shadows onto the toon surface.
  float shadowMapTerm = 1.0;
  if (GetMaterialData(UseShadowReceiving))
  {
    // Find the brightest directional light with shadow data
    ezPerLightData shadowSun = GetBrightestDirectionalLightData();
    uint shadowDataOffset = 0;

    if (shadowSun.intensity > 0.0)
    {
      shadowDataOffset = shadowSun.shadowDataOffsetAndFadeOut & 0xFFFFF;
    }

    // Fallback: search cluster lights for a directional with shadows
    if (shadowDataOffset == 0)
    {
      #if SHADING_QUALITY == SHADING_QUALITY_NORMAL
      ezPerClusterData cl = GetClusterData(G.Input.Position.xyw);
      uint fi = cl.offset;
      uint li = fi + GET_LIGHT_INDEX(cl.counts);
      for (uint si = fi; si < li; ++si)
      {
        uint idx = GET_LIGHT_INDEX(clusterItemBuffer[si]);
        ezPerLightData ld = perLightDataBuffer[idx];
        if (GetLightType(ld) == LIGHT_TYPE_DIR && ld.intensity > 0.0)
        {
          uint off = ld.shadowDataOffsetAndFadeOut & 0xFFFFF;
          if (off != 0)
          {
            shadowSun = ld;
            shadowDataOffset = off;
            break;
          }
        }
      }
      #endif
    }

    if (shadowDataOffset != 0)
    {
      // GetLightDirection returns from-light direction, which is exactly
      // what CalculateShadowTerm expects for the lightVector parameter.
      float3 shadowLightVec = GetLightDirection(shadowSun);

      float noise = InterleavedGradientNoise(G.Input.Position.xy);
      float2x2 rot = {1, 0, 0, 1};

      float3 dbgColor;
      float subsurfShadow;
      float s = CalculateShadowTerm(
        G.Input.WorldPosition, G.Input.Normal,
        shadowLightVec, 1.0, LIGHT_TYPE_DIR,
        shadowSun.shadowDataOffsetAndFadeOut,
        noise, rot, 1.0,
        subsurfShadow, dbgColor);

      shadowMapTerm = s;
    }
  }

  // combinedShadow: toon band * optional shadow receiving
  float combinedShadow = min(shadowWeight, shadowMapTerm);

  float3 shadowAlbedo = albedo * GetMaterialData(ShadowColor).rgb;
  float3 diffuseToon  = lerp(shadowAlbedo, albedo, combinedShadow);

  // ================================================================
  //  ANIME SPECULAR — Blinn-Phong with threshold
  // ================================================================
  float3 halfVec  = normalize(lightDir + viewDir);
  float  NdotH    = saturate(dot(normal, halfVec));
  float  specNDF  = pow(NdotH, GetMaterialData(SpecPower));

  float specThreshold = GetMaterialData(SpecularThreshold);
  float specSoftness  = GetMaterialData(SpecularSoftness);

  // Threshold cut: creates hard anime specular spot
  float specularWeight = smoothstep(
    specThreshold - specSoftness,
    specThreshold + 0.001,
    specNDF);

  // Disable when threshold >= 0.99 (fully OFF)
  specularWeight *= step(specThreshold, 0.99);

  // Specular only appears in lit areas (not in shadow)
  specularWeight *= combinedShadow;

  float3 specularToon = GetMaterialData(SpecColor).rgb
                      * specularWeight
                      * GetMaterialData(SpecularIntensity);

  // ================================================================
  //  RIM LIGHTING — Fresnel edge glow
  // ================================================================
  float NdotV    = max(0.0, dot(normal, viewDir));
  float rimFresnel = pow(1.0 - NdotV, GetMaterialData(RimPower));

  // Hard anime rim: smoothstep to create sharp transition
  float rimWeight = smoothstep(0.4, 0.6, rimFresnel);

  // Rim only in lit areas
  rimWeight *= combinedShadow;

  float3 rimToon = GetMaterialData(RimColor).rgb
                 * rimWeight
                 * GetMaterialData(RimIntensity);

  // ================================================================
  //  BACKLIGHT (Contre-jour) — sun behind the object
  // ================================================================
  float3 backlightRimContrib    = float3(0, 0, 0);
  float  backlightOutlineExpand = 0.0;
  float  backlightOutlineFactor = 0.0;
  float3 backlightOutlineColor  = GetMaterialData(OutlineColor).rgb; // may be overridden

  if (GetMaterialData(UseBacklight))
  {
    // Backlight detection: is the light source behind the object?
    // lightDir = from-light direction, viewDir = toward camera.
    // Sun BEHIND object: both point same way → LdotV > 0 → backlight ON.
    // Sun IN FRONT: opposite directions → LdotV < 0 → backlight OFF.
    float LdotV = dot(lightDir, viewDir);
    float backlight = saturate(LdotV) * smoothstep(0.0, 0.3, NdotV);

    // Apply threshold: only activate above minimum
    backlight = smoothstep(
      GetMaterialData(BacklightThreshold),
      GetMaterialData(BacklightThreshold) + 0.2,
      backlight);

    if (backlight > 0.0)
    {
      // ---- Backlight RIM ----
      // Backlight is independent of shadow — it's contre-jour glow.
      float backlightFresnel = pow(1.0 - NdotV, GetMaterialData(BacklightRimPower));
      float backlightRimWeight = smoothstep(0.3, 0.7, backlightFresnel);
      backlightRimWeight *= backlight;

      float3 blRimColor = GetMaterialData(BacklightRimColor).rgb;
      // Mix or replace original rim color
      if (GetMaterialData(BacklightRimMixBase))
      {
        blRimColor = lerp(GetMaterialData(RimColor).rgb, blRimColor, 0.5);
      }

      backlightRimContrib = blRimColor
                          * backlightRimWeight
                          * GetMaterialData(BacklightRimIntensity);

      // ---- Backlight OUTLINE ----
      backlightOutlineExpand = backlight * GetMaterialData(BacklightOutlineExpand);
      backlightOutlineFactor = backlight * GetMaterialData(BacklightOutlineIntensity);

      float3 blOutlineColor = GetMaterialData(BacklightOutlineColor).rgb;
      // Mix or replace original outline color
      if (GetMaterialData(BacklightOutlineMixBase))
      {
        backlightOutlineColor = lerp(GetMaterialData(OutlineColor).rgb, blOutlineColor, backlight * backlightOutlineFactor);
      }
      else
      {
        backlightOutlineColor = blOutlineColor;
      }
    }
  }

  // ================================================================
  //  LATEX / GLOSSY FRESNEL (optional overlay)
  // ================================================================
  float3 latexContrib = float3(0, 0, 0);
  if (GetMaterialData(UseLatexFresnel))
  {
    float latexFresnel = pow(1.0 - NdotV, GetMaterialData(LatexFresnelPower));
    latexContrib = GetMaterialData(LatexFresnelColor).rgb
                 * latexFresnel
                 * GetMaterialData(LatexFresnelIntensity);
  }

  // ================================================================
  //  OUTLINE — NdotV edge detection
  // ================================================================
  float outlineWidth = GetMaterialData(OutlineWidth) + backlightOutlineExpand;
  // step(width, NdotV) = 1 when looking at face, 0 at silhouette edge
  float outlineMix = step(outlineWidth, max(0.0, NdotV));

  // ================================================================
  //  FINAL ASSEMBLY
  // ================================================================
  float3 toonColor  = diffuseToon + specularToon + rimToon + backlightRimContrib + latexContrib;
  float3 finalColor  = lerp(backlightOutlineColor, toonColor, outlineMix);

  return finalColor * GetMaterialData(EmissionMultiplier);
}